{
  "name": "nutriscan",
  "private": true,
  "workspaces": [
    "app",
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @nutriscan/api",
    "dev:app": "npm run start -w @nutriscan/app",
    "test": "npm run test -w @nutriscan/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @nutriscan/api",
    "produtores:importar": "npm run produtores:importar -w @nutriscan/api --",
    "produtores:pedidos": "npm run produtores:pedidos -w @nutriscan/api --",
    "produtores:contas": "npm run produtores:contas -w @nutriscan/api --",
    "produtores:itens": "npm run produtores:itens -w @nutriscan/api --"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
