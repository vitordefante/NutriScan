# Copie para .env (que não vai para o Git): cp .env.example .env
NODE_ENV=development
PORT=3333
# 0.0.0.0 permite que o iPhone na mesma rede Wi-Fi acesse a API do Mac
HOST=0.0.0.0
DATABASE_URL=postgres://nutriscan:nutriscan@localhost:5432/nutriscan
# Só em desenvolvimento: guarda o texto do OCR de cada foto de rótulo (para depurar leituras)
OCR_DEBUG_DIR=data/ocr
# Segredo dos tokens de login (mín. 32 caracteres, aleatório). Gerar com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-48-bytes
# Só no deploy: quantos proxies ficam na frente da API (o balanceador da nuvem: 1). Sem isso,
# os limites "por endereço" (login, pedidos de produtor) valem para todos juntos.
# TRUST_PROXY=1
