# Copie para .env (que não vai para o Git): cp .env.example .env
NODE_ENV=development
PORT=3333
# 0.0.0.0 permite que o iPhone na mesma rede Wi-Fi acesse a API do Mac
HOST=0.0.0.0
DATABASE_URL=postgres://nutriscan:nutriscan@localhost:5432/nutriscan
# Só em desenvolvimento: guarda o texto do OCR de cada foto de rótulo (para depurar leituras)
OCR_DEBUG_DIR=data/ocr
