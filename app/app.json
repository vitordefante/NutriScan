{
  "expo": {
    "name": "NutriScan",
    "slug": "nutriscan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutriscan",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.vitordefante.nutriscan",
      "appleTeamId": "YXHT8F5Z28"
    },
    "android": {
      "package": "com.vitordefante.nutriscan",
      "adaptiveIcon": {
        "backgroundColor": "#F8F6DE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O NutriScan usa a câmera para ler o código de barras, fotografar rótulos e, se você for produtor, fotografar os itens do seu catálogo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O NutriScan usa a câmera para ler o código de barras, fotografar rótulos e, se você for produtor, fotografar os itens do seu catálogo.",
          "photosPermission": "O NutriScan abre a foto que você escolher: a de um rótulo, para ler os ingredientes (ela fica no aparelho), ou a de um item do seu catálogo de produtor (enviada para aparecer no mapa).",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O NutriScan usa sua localização para mostrar os produtores rurais mais perto de você. Ela fica no aparelho e não é enviada ao servidor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "url": "https://u.expo.dev/d8bfad9f-e38a-4907-ac95-ed980f5c4a95"
    },
    "extra": {
      "eas": {
        "projectId": "d8bfad9f-e38a-4907-ac95-ed980f5c4a95"
      }
    },
    "owner": "vitordefante"
  }
}
